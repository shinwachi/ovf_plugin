Require-Bundle: org.eclipse.ui,
 org.eclipse.core.runtime,
 org.eclipse.core.resources,
 org.eclipse.core.jobs,
 org.eclipse.equinox.preferences,
 org.eclipse.jface,
 org.eclipse.e4.ui.model.workbench,
 org.eclipse.e4.ui.workbench,
 org.knime.core
Eclipse-AutoStart: true
Export-Package: org.ovf.serverconnector,
 org.ovf.serverconnector.views,
 org.ovf.serverconnector.model,
 org.ovf.serverconnector.client,
 org.ovf.serverconnector.actions,
 org.ovf.serverconnector.util,
 org.ovf.serverconnector.preferences,
 org.ovf.serverconnector.dnd
