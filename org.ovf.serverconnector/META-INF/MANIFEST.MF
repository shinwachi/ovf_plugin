Manifest-Version: 1.0
Bundle-ManifestVersion: 2
Bundle-Name: OVF Server Explorer
Bundle-SymbolicName: org.ovf.serverconnector;singleton:=true
Bundle-Version: 1.0.2
Bundle-Vendor: OVF
Bundle-RequiredExecutionEnvironment: JavaSE-17
Bundle-Activator: org.ovf.serverconnector.ServerConnectorActivator
Import-Package: org.osgi.framework,
